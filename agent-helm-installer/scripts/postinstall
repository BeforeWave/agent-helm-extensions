#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/installer-lib.sh"

package_path=${1:-${PACKAGE_PATH:-}}
default_extension_id="__AGENT_HELM_CHROME_EXTENSION_ID__"
agent_helm_preflight "$package_path" "$default_extension_id"
extension_id=$(agent_helm_extension_id_from_package "$package_path" "$default_extension_id")
install_user=$(agent_helm_console_user)
install_home=$(agent_helm_user_home "$install_user")
backend="$SCRIPT_DIR/agent-helm-install.sh"
runtime_bundle="$SCRIPT_DIR/agent-helm-runtime.tgz"
[ -f "$backend" ] || agent_helm_fail "Canonical Agent Helm install backend is missing from the package."
[ -f "$runtime_bundle" ] || agent_helm_fail "Bundled Agent Helm runtime is missing from the package."

agent_helm_stage 2 "Agent Helm: installing pinned runtime __AGENT_HELM_VERSION__"
/usr/bin/sudo -H -u "$install_user" /usr/bin/env \
  HOME="$install_home" \
  AGENT_HELM_CHROME_EXTENSION_ID="$extension_id" \
  AGENT_HELM_VERSION="__AGENT_HELM_VERSION__" \
  AGENT_HELM_RUNTIME_BUNDLE="$runtime_bundle" \
  AGENT_HELM_RUNTIME_BUNDLE_SHA256="__AGENT_HELM_RUNTIME_SHA256__" \
  /bin/sh "$backend"

agent_helm_stage 3 "Native Messaging bridge: registered for $extension_id"
agent_helm_stage 4 "Postflight: validating Agent Helm and bridge"
agent_helm_postflight "$install_home" "$extension_id"
if [ -n "$extension_id" ]; then
  printf '%s\n' "Agent Helm installation complete for Chrome Extension $extension_id."
else
  printf '%s\n' "Agent Helm installation complete. Run 'agent-helm setup chrome' later if Chrome integration is needed."
fi
exit 0
