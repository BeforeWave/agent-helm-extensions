{
  "name": "agent-helm-chrome-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --config vite.preview.config.ts",
    "dev:extension": "wxt",
    "build": "wxt prepare && wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@beforewave/agent-helm-ui-contract": "0.1.3"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "latest",
    "@wxt-dev/module-react": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest",
    "wxt": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
