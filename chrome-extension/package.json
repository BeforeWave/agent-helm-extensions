{
  "name": "agent-helm-chrome-extension",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev:web": "vite --config vite.preview.config.ts",
    "dev:extension": "wxt",
    "build": "npm run prepare:shared && wxt prepare && wxt build",
    "zip": "wxt zip",
    "typecheck": "npm run prepare:shared && wxt prepare && tsc --noEmit",
    "test": "npm run prepare:shared && vitest run",
    "verify:production": "npm run build && node scripts/verify-production.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:production",
    "build:standalone": "npm run prepare:shared && vite build --config vite.standalone.config.ts",
    "standalone": "node scripts/dev-standalone.mjs",
    "prepare:shared": "node scripts/prepare-shared.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "latest",
    "@wxt-dev/module-react": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest",
    "wxt": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "agentHelm": {
    "version": "0.1.5"
  }
}
